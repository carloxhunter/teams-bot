{
  "name": "teams-bot",
  "version": "1.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node --env-file=.env src/cli.js",
    "once": "node --env-file=.env src/cli.js --once",
    "send": "node --env-file=.env src/cli.js --send",
    "test-message": "node --env-file=.env src/cli.js --test-message",
    "show": "node src/cli.js --show",
    "preview": "node src/cli.js --preview",
    "test": "node --test test/bot.test.js && vitest run",
    "deploy": "wrangler deploy",
    "migrate:d1": "node scripts/migrate-to-d1.js",
    "debug:resend": "node --env-file=.env scripts/debug-resend.js",
    "lint": "oxlint",
    "audit": "pnpm audit --prod --audit-level=high"
  },
  "devDependencies": {
    "oxlint": "^1.90.0",
    "vitest": "^5.0.5",
    "@cloudflare/vitest-plugin": "^1.4.11",
    "wrangler": "^4.156.0"
  }
}
