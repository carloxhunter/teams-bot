{
  "name": "teams-bot",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Cloudflare account "bots" (only for bots, apart from OpenSpend and the toolbox). Account IDs aren't secrets.
  "account_id": "b20c6089b80c5fec5f477d3ad241035c",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["0,15,30 12,13 * * 1-5"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "teams-bot",
      // No database_id: auto-provisioned on first deploy.
      "migrations_dir": "migrations"
    }
  ],
  // TEAMS_WEBHOOK_URL is a secret: set it with `wrangler secret put TEAMS_WEBHOOK_URL`.
  "vars": { "TIME_ZONE": "America/Santiago", "ANNOUNCEMENT_TIME": "09:00" }
}
