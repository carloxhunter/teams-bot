{
  "name": "teams-bot",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Cloudflare account "bots" (only for bots, apart from OpenSpend and the toolbox). Account IDs aren't secrets.
  "account_id": "b20c6089b80c5fec5f477d3ad241035c",
  // workers.dev only serves POST /debug/resend-last (Bearer DEBUG_TOKEN); everything else is 404.
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Cron is UTC: covers 08:30-09:25 Chile in both UTC-3 (11:30-12:25Z) and UTC-4 (12:30-13:25Z); every 5 minutes acts as retry.
  "triggers": { "crons": ["*/5 11,12,13 * * 1-5"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "teams-bot",
      // No database_id: auto-provisioned on first deploy.
      "migrations_dir": "migrations"
    }
  ],
  // TEAMS_WEBHOOK_URL and DEBUG_TOKEN are secrets: set them with `wrangler secret put <NAME>`.
  "vars": { "TIME_ZONE": "America/Santiago", "ANNOUNCEMENT_TIME": "08:30", "ANNOUNCEMENT_LAST_TRY": "09:25" }
}
